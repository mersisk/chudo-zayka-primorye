# Хранить на VDS только как /etc/chudozaika/api.env, права 640, владелец root:chudozaika.
# Не добавлять этот файл с реальными значениями в Git.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://chudozaika:CHANGE_ME@127.0.0.1:5432/chudozaika
CORS_ORIGIN=https://chydozaika.ru
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=10
API_JSON_LIMIT_BYTES=24576

# Только секреты VDS. Заполните их вручную и не коммитьте этот файл с реальными значениями.
BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
PROXY_HOST=CHANGE_ME
PROXY_PORT=1080
PROXY_USER=CHANGE_ME
PROXY_PASS=CHANGE_ME
