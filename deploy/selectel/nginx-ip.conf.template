# Шаблон для /etc/nginx/sites-available/chudozaika
# Production-конфигурация для chydozaika.ru. HTTPS-блок добавляется отдельно.

limit_req_zone $binary_remote_addr zone=chudozaika_api:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=chudozaika_conn:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name chydozaika.ru www.chydozaika.ru 135.106.210.15;

    root /srv/chudozaika/app/dist;
    index index.html;
    server_tokens off;
    client_max_body_size 64k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /api {
        return 308 /api/;
    }

    # API слушает только 127.0.0.1:3000. Браузер обращается к нему через тот же origin,
    # поэтому CORS для публичного сайта не требуется.
    location /api/ {
        limit_req zone=chudozaika_api burst=20 nodelay;
        limit_conn chudozaika_conn 10;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
